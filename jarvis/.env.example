# ===== Copie este arquivo para ".env" e preencha =====

# --- Cérebro (obrigatório) ---
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (equilíbrio) ou claude-haiku-5-5 (mais barato e rápido)
JARVIS_MODELO=claude-sonnet-5-5

# --- Você ---
USUARIO_NOME=Pedro
USUARIO_TRATAMENTO=senhor
CIDADE_PADRAO=Brasília

# --- Voz do Jarvis ---
# Liste as vozes com:  edge-tts --list-voices | findstr pt-BR
VOZ=pt-BR-AntonioNeural
VOZ_VELOCIDADE=+5%
VOZ_TOM=-4Hz

# --- Microfone ---
# tiny / base / small / medium  (maior = mais preciso e mais lento)
WHISPER_MODELO=small

# --- Palavra de ativação ---
# whisper      = diga só "Jarvis" (ou "Jarvis, abre o Chrome" de uma vez)
# openwakeword = diga "Hey Jarvis" (mais leve para PCs fracos)
WAKE_MOTOR=whisper
# nome que acorda o assistente (motor whisper)
WAKE_PALAVRA=jarvis
# modelo que procura o nome: tiny (mais leve) / base / small (mais preciso)
WAKE_WHISPER_MODELO=base
# motor openwakeword: modelo pronto ou caminho de um .onnx próprio
WAKE_WORD=hey_jarvis
# motor openwakeword: 0.3 = mais sensível | 0.7 = mais exigente
WAKE_LIMIAR=0.5
# volume mínimo para considerar fala; aumente se o ambiente for barulhento
MIC_LIMIAR_MIN=400
# deixe vazio para o microfone padrão (ou ponha o número que o diagnostico.bat mostrar)
MIC_DISPOSITIVO=

# --- Comportamento ---
SAUDACAO_AO_INICIAR=true
OUVIR_APOS_PERGUNTA=true
DEBUG=false

# --- Spotify (opcional, exige Premium) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
