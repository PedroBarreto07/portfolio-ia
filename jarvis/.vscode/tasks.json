{
  // Ctrl+Shift+P > "Tasks: Run Task"
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jarvis: instalar (cria .venv e baixa modelos)",
      "type": "shell",
      "command": "${workspaceFolder}\\instalar.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Jarvis: testes",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "unittest", "discover", "-s", "testes", "-t", ".", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Jarvis: conectar Google",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["conectar_google.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Jarvis: conectar Spotify",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["conectar_spotify.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
